{
  "manifest_version": 3,
  "name": "Школково — свободные чаты",
  "version": "1.11.7",
  "description": "Уведомления о свободных и закреплённых чатах с учётом действующего дежурства по Москве.",
  "browser_specific_settings": { "safari": { "strict_min_version": "17.4" } },
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://1.shkolkovo.online/*", "https://docs.google.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" },
  "action": {
    "default_title": "Свободные чаты Школково",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://1.shkolkovo.online/chat", "https://1.shkolkovo.online/chat?*",
      "https://1.shkolkovo.online/chat/", "https://1.shkolkovo.online/chat/?*"],
    "js": ["identity.js", "dom.js", "connection.js", "content.js"],
    "run_at": "document_idle"
  }]
}
