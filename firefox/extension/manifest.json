{
  "manifest_version": 3,
  "name": "Школково — свободные чаты",
  "version": "1.10.0",
  "description": "Уведомления о свободных и закреплённых чатах с учётом действующего дежурства по Москве.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shkolkovo-chat-monitor@extension.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["notifications", "storage", "alarms"],
  "host_permissions": ["https://1.shkolkovo.online/*", "https://docs.google.com/*"],
  "background": { "scripts": ["identity.js", "engine.js", "schedule.js", "time.js", "background.js"] },
  "icons": { "128": "icon.png" },
  "action": {
    "default_title": "Свободные чаты Школково",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://1.shkolkovo.online/chat", "https://1.shkolkovo.online/chat/*", "https://1.shkolkovo.online/chat?*"],
    "js": ["identity.js", "dom.js", "connection.js", "content.js"],
    "run_at": "document_idle"
  }]
}
